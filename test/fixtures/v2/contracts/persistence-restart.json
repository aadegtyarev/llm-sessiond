{
  "migrations": [
    {
      "from": 0,
      "to": 1,
      "transactional": true,
      "pragma": "user_version",
      "journalMode": "WAL"
    },
    { "unknownNewer": "startup-blocked" },
    { "corrupt": "startup-blocked" }
  ],
  "genericColumns": [
    "id",
    "harness_id",
    "cwd",
    "status",
    "name",
    "native_session_id",
    "adapter_options",
    "adapter_state",
    "failure_reason",
    "failed_at",
    "created_at"
  ],
  "forbiddenColumns": ["pi_session_id", "claude_model", "permission_mode"],
  "reconciliation": [
    { "from": "running", "to": "stopped", "launch": false },
    { "from": "starting", "to": "stopped", "launch": false },
    {
      "from": "failed",
      "checkpointResumable": true,
      "to": "stopped",
      "preserveFailure": true
    },
    { "from": "failed", "checkpointResumable": false, "preserveStatus": true }
  ],
  "checkpoints": [
    {
      "namespace": "third-harness.audit",
      "version": 3,
      "data": { "resumeKey": "opaque-5" },
      "maxBytes": 65536,
      "secret": false
    },
    { "unknownVersion": "preserve-record-and-fail" },
    { "staleInstanceWrite": "reject" },
    { "migration": "registered-adapter-hook" }
  ],
  "shutdown": {
    "clientDetach": "does-not-stop-session-or-process",
    "daemonOrder": [
      "not-ready",
      "begin-close",
      "invalidate-guards-and-callbacks",
      "bounded-drain-stop-join",
      "close-transports-store"
    ],
    "hardCrashOrphanGuarantee": false
  }
}
